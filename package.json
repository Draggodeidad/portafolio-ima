{
  "name": "imanol-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'tests/**/*.{ts,tsx}' messages/*.json docs/*.md playwright.config.ts AGENTS.md README.md package.json tsconfig.json next.config.ts eslint.config.mjs postcss.config.mjs pnpm-workspace.yaml '.github/workflows/*.yml' vercel.json vite.config.mts wrangler.jsonc",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'tests/**/*.{ts,tsx}' messages/*.json docs/*.md playwright.config.ts AGENTS.md README.md package.json tsconfig.json next.config.ts eslint.config.mjs postcss.config.mjs pnpm-workspace.yaml '.github/workflows/*.yml' vercel.json vite.config.mts wrangler.jsonc",
    "test:e2e": "playwright test",
    "check:workers": "vinext check",
    "dev:workers": "vite --host 127.0.0.1",
    "build:workers": "vite build",
    "preview:workers": "vite preview",
    "test:e2e:workers": "PLAYWRIGHT_RUNTIME=workers playwright test",
    "build:workers:production": "CLOUDFLARE_ENV=production SITE_URL=https://imanolantonio.dev vite build",
    "test:e2e:workers:production": "SITE_URL=https://imanolantonio.dev PLAYWRIGHT_RUNTIME=workers playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vinext/cloudflare": "1.3.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.4.4",
    "vite": "8.3.6",
    "vite-css-modules": "1.16.1",
    "wrangler": "4.158.0"
  }
}
