# Public canonical origin. Never store deployment credentials here.
SITE_URL=https://itsdraggodeidad-portfolio.vercel.app

# Workers production build sets this explicitly; existing Next/Vercel stays above.
# SITE_URL=https://imanolantonio.dev

# Contact: only configure after creating a Turnstile widget and the email Worker.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CF_WORKER_URL=
CF_WORKER_AUTH_SECRET=
# Use cf-connecting-ip on Cloudflare Workers or x-vercel-forwarded-for on Vercel.
CONTACT_IP_HEADER=
